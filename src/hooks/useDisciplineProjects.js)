import { useMemo } from 'react';
import { projectsData } from '../data/projectsData.js';

/**
 * Fisher-Yates shuffle algorithm for impartial randomization
 */
function shuffleArray(array) {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

/**
 * Hook to retrieve projects prioritized by discipline mode ('spatial' or 'cinematic')
 * @param {string} mode - 'spatial', 'cinematic', or 'all'
 * @param {boolean} randomize - Whether to shuffle within category groups
 */
export function useDisciplineProjects(mode = 'spatial', randomize = true) {
  return useMemo(() => {
    if (!mode || mode === 'all') {
      return randomize ? shuffleArray(projectsData) : projectsData;
    }

    // Split projects into target mode and secondary works
    const primaryWorks = projectsData.filter((p) =>
      p.categoryType?.includes(mode)
    );
    const secondaryWorks = projectsData.filter(
      (p) => !p.categoryType?.includes(mode)
    );

    // Apply randomization per subgroup if requested
    const finalPrimary = randomize ? shuffleArray(primaryWorks) : primaryWorks;
    const finalSecondary = randomize ? shuffleArray(secondaryWorks) : secondaryWorks;

    return [...finalPrimary, ...finalSecondary];
  }, [mode, randomize]);
}